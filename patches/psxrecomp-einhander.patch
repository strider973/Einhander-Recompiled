+    # fallback, so ordinary in-function load-delay pairs are unchanged.
+    ldd_refs = set(re.findall(r'\bpsx_ldd_([0-9A-Fa-f]{8})\b', src))
+    if ldd_refs:
+        fallback = ''.join(
+            f'static uint32_t psx_ldd_{addr} = 0;  /* cross-fragment load delay */\n'
+            for addr in sorted(ldd_refs))
+        src = src.replace(DISPATCH_PREAMBLE,
+                          DISPATCH_PREAMBLE + fallback, 1)
+
     return src
 
 
